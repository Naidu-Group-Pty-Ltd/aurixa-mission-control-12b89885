# ─────────────────────────────────────────────────────────────────────────────
# Aurixa Mission Control — environment template
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# VITE_-prefixed vars are exposed to the browser bundle — keep secrets OUT of them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (client-public: anon/publishable key + URL) ─────────────────────
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# ── Supabase (server) ────────────────────────────────────────────────────────
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
SUPABASE_ANON_KEY="your-anon-publishable-key"
# SECRET — bypasses RLS. Server-only. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Credential encryption at rest — SET THIS ─────────────────────────────────
# `encryptSecret` is a NO-OP when this is unset. It does not warn, it does not
# fail, and the columns are still called `..._ciphertext` and `..._enc`. What it
# protects, all of it stored in Mission Control's own database:
#
#   • every managed clone's Supabase SERVICE ROLE KEY  (clone_backends)
#   • every managed clone's DATABASE PASSWORD          (clone_backends)
#   • client Supabase personal access tokens           (client_supabase_accounts)
#   • queued clone admin passwords                     (clone_backends)
#   • per-clone Stripe webhook secrets                 (clone_stripe_configs)
#
# Unset, all of the above sit in plaintext in Postgres. The flag is technically
# opt-in only because it post-dates the rows it protects: `decryptSecret` reads
# legacy plaintext transparently, so turning it on is safe at any time and each
# value is re-encrypted the next time it is written.
#
# `/api/health` reports `checks.credential_encryption` so you can tell which
# state a deployment is actually in.
CREDENTIALS_ENC_KEY="a-long-random-encryption-secret"    # SECRET

# ── Supabase Management API (provisioning clone backends) ────────────────────
SB_MGMT_API_TOKEN="your-supabase-management-api-token"   # SECRET
SB_ORG_ID="your-supabase-org-id"

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_or_test_..."                  # SECRET
STRIPE_WEBHOOK_SECRET="whsec_..."                        # SECRET

# ── GitHub App (clone repo automation) ───────────────────────────────────────
GITHUB_APP_ID="123456"
GITHUB_APP_INSTALLATION_ID="12345678"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"  # SECRET
GITHUB_WEBHOOK_SECRET="your-github-webhook-secret"       # SECRET

# ── Cloudflare (clone DNS/Pages provisioning) ────────────────────────────────
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"         # SECRET

# ── AI gateway ───────────────────────────────────────────────────────────────
LOVABLE_API_KEY="your-ai-gateway-key"                    # SECRET

# ── Codex Security (scans + autonomous remediation) ──────────────────────────
# Which engine executes scans:
#   github_actions (default) — dispatches .github/workflows/codex-security-scan.yml
#                              in the target repo via the Aurixa GitHub App. Needs
#                              no key of its own; reuses the GITHUB_APP_* config
#                              above. This is the engine that actually runs today.
#   http                     — POSTs to a hosted scan API (CODEX_SECURITY_BASE_URL).
#                              Only set this once such an API is actually available.
# CODEX_SECURITY_ENGINE="github_actions"
# CODEX_SECURITY_BASE_URL="https://your-scan-api.example.com/v1"
# Override the workflow filename dispatched in target repos.
# CODEX_SCAN_WORKFLOW_FILE="codex-security-scan.yml"

# HMAC secret the scanner signs its result callbacks with. Optional: when unset,
# the auto-generated secret on the built-in `codex` row of
# public.security_intake_sources is used instead, so a fresh deployment works
# with no manual provisioning.
CODEX_SECURITY_WEBHOOK_SECRET="a-long-random-secret"     # SECRET
# Same, for the remediation workflow's PR lifecycle callbacks. Falls back to the
# scan secret above when unset.
CODEX_REMEDIATION_WEBHOOK_SECRET="a-long-random-secret"  # SECRET
# Model API key for the Codex CLI (scan reasoning pass + remediation patches).
# Mission Control pushes this into each managed repo as an Actions secret.
# CODEX_SECURITY_API_KEY is accepted as a legacy alias.
OPENAI_API_KEY="sk-..."                                  # SECRET
# CODEX_SECURITY_API_KEY="sk-..."                        # SECRET (legacy alias)

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY="your-vapid-public-key"
# VAPID_PRIVATE_KEY is configured as a Supabase Edge Function secret (push-fanout), not here.

# ── Cron / scheduled hooks shared secret ─────────────────────────────────────
# All /hooks/* endpoints require this dedicated secret as a Bearer token (the
# public publishable/anon key is NO LONGER accepted). Set the SAME value as the
# Postgres GUC so pg_cron jobs can send it:
#   ALTER DATABASE postgres SET app.settings.cron_secret = '<same value>';
CRON_SECRET="your-cron-shared-secret"                    # SECRET
# Deprecated fallback, still accepted during rollout (used by /hooks/drift-refresh).
DRIFT_REFRESH_TOKEN="your-cron-shared-secret"            # SECRET

# ── Waitlist lead capture (website → Mission Control tie-up) ─────────────────
# Shared secret for server-to-server lead delivery (e.g. a Make.com HTTP
# module forwarding the waitlist webhook). Requests carrying this value in the
# `x-lead-capture-secret` header (or as a Bearer token) bypass the browser
# origin check and rate limits on POST /api/public/leads/capture.
LEAD_CAPTURE_SECRET="your-lead-capture-shared-secret"    # SECRET
# Extra comma-separated browser origins allowed to dual-write leads (the
# aurixasystems.com.au origins and localhost:3000 are always allowed).
# LEAD_CAPTURE_ALLOWED_ORIGINS="https://staging.aurixasystems.com.au"
#
# Airtable personal access token for the "NPC Emails" base, which holds the
# Aurixa Waitlist / BRQ Detailed Responses / Strategic Review Bookings tables.
# Read by POST /hooks/airtable-sync (with LOVABLE_API_KEY above, which
# authenticates the connector gateway that fronts Airtable). Without it the
# sync throws and Stage 2 / Stage 3 progress never reaches Mission Control.
AIRTABLE_API_KEY="your-airtable-personal-access-token"   # SECRET

# ── Email campaigns (Microsoft Graph) ────────────────────────────────────────
# The application registration the email scheduler sends and reads mail with —
# the SAME tenant and app credentials the prime property dashboard holds, so a
# campaign leaves from a mailbox recipients already recognise.
#
# Client-credentials (application) identity, needing two Graph application
# permissions with admin consent:
#   Mail.Send  — to send a campaign message
#   Mail.Read  — to read the sending mailbox for delivery-status reports, which
#                is the ONLY source of bounces this product has. Graph raises no
#                webhook when an application-identity send fails downstream, so
#                without Mail.Read the "never mail an address that bounced" rule
#                has nothing to enforce and reports itself as working.
#
# An application permission reaches EVERY mailbox in the tenant unless an
# Exchange ApplicationAccessPolicy scopes it. Scoping it to the sending mailbox
# is strongly recommended and costs one PowerShell command.
#
# All three unset is a supported state: campaigns can be written and lists
# uploaded, and the page says the deployment cannot send.
MICROSOFT_TENANT_ID="00000000-0000-0000-0000-000000000000"
MICROSOFT_CLIENT_ID="00000000-0000-0000-0000-000000000000"
MICROSOFT_CLIENT_SECRET="your-app-registration-client-secret"   # SECRET
# The mailbox campaigns send from when they do not name one themselves, and the
# mailbox the bounce scan reads.
MICROSOFT_MAILBOX_EMAIL="campaigns@yourdomain.com"

# ── App ──────────────────────────────────────────────────────────────────────
# Public origin of this deployment. Used to build the webhook callback URLs
# handed to scan/remediation workflows, so it must be reachable from GitHub
# Actions. APP_PUBLIC_URL is accepted as an equivalent alias.
PUBLIC_APP_URL="https://your-mission-control-domain"

# ── Customer storefront (user-attributed pricing workflow) ───────────────────
# Full URL of the CUSTOMER-FACING pricing page on the Aurixa Systems website.
# All user-centric monetisation (tokens, plans, seats — prime + clones) lands
# here; Mission Control serves no /pricing route of its own (operators use the
# /billing/* consoles). Handoff deep links and packs topup_urls are minted
# against this base (unset = the default storefront domain in
# src/lib/storefront.ts), and storefront checkout success/cancel redirects
# return to <this URL>/success|/cancel.
PUBLIC_PRICING_SITE_URL="https://www.aurixasystems.com.au/pricing"
